name: Mise à jour observations Météo-World

on:
  schedule:
    - cron: "*/5 * * * *"

  workflow_dispatch:

jobs:
  update-observations:
    runs-on: ubuntu-latest

    steps:
      - name: Déclencher update-observations.php
        run: |
          curl --fail --show-error --silent \
            --max-time 120 \
            "https://meteo-world.fr/cartes/temperatures-min/update-temperatures-min.php "
